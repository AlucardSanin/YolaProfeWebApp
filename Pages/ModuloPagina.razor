@page "/modulo/{Id}"
@inject ContenidoService Contenido
@inject AnaliticaService Analitica
@inject IJSRuntime JS

<PageTitle>@(_modulo is null ? "Módulo" : $"Módulo {_modulo.Numero}: {_modulo.Titulo}") · @_sitio?.NombrePlataforma</PageTitle>

@if (_noEncontrado)
{
    <div class="aviso">
        <strong>Este módulo no existe.</strong>
        <p><a href="">Volver al inicio</a></p>
    </div>
}
else if (_modulo is null || _sitio is null)
{
    <EstadoCarga Error="@_error" />
}
else
{
    <article class="modulo">
        <header class="modulo-cabecera">
            <p class="etiqueta">Módulo @_modulo.Numero de @_total</p>
            <h1>@_modulo.Titulo</h1>
            <nav class="indice" aria-label="Secciones del módulo">
                @foreach (var (id, texto) in _secciones)
                {
                    <button type="button" class="indice-chip @(id == "reto" ? "indice-chip-reto" : "")"
                            @onclick="() => IrAAsync(id)">@texto</button>
                }
            </nav>
        </header>

        <div class="objetivos">
            <section class="caja caja-objetivo">
                <h2>Objetivo del módulo</h2>
                <Markdown Texto="@_modulo.Objetivo" />
            </section>
            <section class="caja caja-importancia">
                <h2>¿Por qué es importante?</h2>
                <Markdown Texto="@_modulo.PorQueImporta" />
            </section>
        </div>

        @if (!string.IsNullOrWhiteSpace(_teoria))
        {
            <section class="bloque" id="teoria">
                <h2 class="seccion-titulo">📘 Puntos clave</h2>
                <Markdown Texto="@_teoria" Carpeta="@_carpeta" />
            </section>
        }

        @if (_modulo.Videos.Count > 0)
        {
            <section class="bloque" id="videos">
                <h2 class="seccion-titulo">🎬 Videos de apoyo</h2>
                <p class="bloque-nota">Los videos se reproducen aquí mismo, sin salir de la plataforma.</p>
                <div class="videos">
                    @foreach (var video in _modulo.Videos)
                    {
                        <VideoYoutube Video="video" Modulo="_modulo.Numero" />
                    }
                </div>
            </section>
        }

        @foreach (var grupo in _grupos)
        {
            <section class="bloque" id="@grupo.Id">
                <h2 class="seccion-titulo">@grupo.Titulo</h2>
                <ul class="recursos">
                    @foreach (var enlace in grupo.Enlaces)
                    {
                        <TarjetaRecurso Enlace="enlace" Modulo="_modulo.Numero" OnAbrirAqui="e => _visor = e" />
                    }
                </ul>
            </section>
        }

        <section class="reto" id="reto" aria-labelledby="titulo-reto">
            <p class="etiqueta etiqueta-reto">🎯 Actividad evaluativa</p>
            <h2 id="titulo-reto">@_modulo.Reto.Titulo</h2>
            <Markdown Texto="@_reto" Carpeta="@_carpeta" />

            <ol class="pasos">
                <li><strong>Graba</strong> tu audio con el teléfono (.mp3, .m4a o .wav).</li>
                <li><strong>Abre el formulario</strong> e inicia sesión con tu cuenta de Google (Gmail): Google lo pide para poder adjuntar archivos.</li>
                <li><strong>Completa tus datos, adjunta el audio y pulsa "Enviar".</strong> Luego puedes volver a esta pestaña.</li>
            </ol>

            @if (_urlFormulario is not null)
            {
                <a class="boton boton-grande boton-reto" href="@_urlFormulario" target="_blank" rel="noopener"
                   @onclick="AbrirFormularioAsync">Abrir el formulario y subir mi audio ↗</a>
                <p class="reto-nota">El formulario se abre en una pestaña nueva; esta página queda abierta.</p>
            }
            else
            {
                <span class="boton boton-grande boton-deshabilitado" aria-disabled="true">Formulario no disponible todavía</span>
            }

            @if (!string.IsNullOrWhiteSpace(_modulo.Reto.MensajeFinal))
            {
                <p class="reto-final">@_modulo.Reto.MensajeFinal</p>
            }
        </section>

        <nav class="paginacion" aria-label="Módulos">
            @if (_anterior is not null)
            {
                <a class="paginacion-enlace" href="@($"modulo/{_anterior.Id}")">
                    <span class="paginacion-etiqueta">← Anterior</span>Módulo @_anterior.Numero: @_anterior.Titulo
                </a>
            }
            else
            {
                <a class="paginacion-enlace" href=""><span class="paginacion-etiqueta">← Volver</span>Inicio</a>
            }
            @if (_siguiente is not null)
            {
                <a class="paginacion-enlace paginacion-siguiente" href="@($"modulo/{_siguiente.Id}")">
                    <span class="paginacion-etiqueta">Siguiente →</span>Módulo @_siguiente.Numero: @_siguiente.Titulo
                </a>
            }
        </nav>
    </article>

    <VisorRecurso Enlace="_visor" OnCerrar="() => _visor = null" />
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private record Grupo(string Id, string Titulo, string Indice, List<Enlace> Enlaces);

    private static readonly (string Tipo, string Titulo, string Indice)[] TiposRecurso =
    [
        ("lectura", "📖 Lecturas de apoyo", "Lecturas"),
        ("practica", "🎧 Prácticas interactivas", "Prácticas"),
        ("quiz", "✅ Quizzes y juegos", "Quizzes"),
    ];

    private Sitio? _sitio;
    private Modulo? _modulo;
    private Modulo? _anterior;
    private Modulo? _siguiente;
    private int _total;
    private Uri? _carpeta;
    private string? _teoria;
    private string? _reto;
    private string? _urlFormulario;
    private string? _error;
    private bool _noEncontrado;
    private Enlace? _visor;
    private List<Grupo> _grupos = [];
    private List<(string Id, string Texto)> _secciones = [];

    protected override async Task OnParametersSetAsync()
    {
        _modulo = null;
        _visor = null;
        _error = null;
        _noEncontrado = false;
        try
        {
            _sitio = await Contenido.ObtenerSitioAsync();
            var modulos = await Contenido.ObtenerModulosAsync();
            var indice = modulos.FindIndex(m => m.Id == Id);
            if (indice < 0)
            {
                _noEncontrado = true;
                return;
            }

            var modulo = modulos[indice];
            _total = modulos.Count;
            _anterior = indice > 0 ? modulos[indice - 1] : null;
            _siguiente = indice < modulos.Count - 1 ? modulos[indice + 1] : null;
            _carpeta = await Contenido.UrlAsync($"modulos/{Id}/");

            var teoria = Contenido.ObtenerTextoAsync($"modulos/{Id}/teoria.md");
            var reto = Contenido.ObtenerTextoAsync($"modulos/{Id}/reto.md");
            _teoria = await teoria;
            _reto = await reto;
            _urlFormulario = ContenidoService.UrlFormulario(_sitio, modulo);

            // Los tipos desconocidos se muestran como lecturas.
            var conocidos = TiposRecurso.Select(t => t.Tipo).ToHashSet();
            string TipoDe(Enlace e) => conocidos.Contains(e.Tipo?.Trim().ToLowerInvariant() ?? "") ? e.Tipo!.Trim().ToLowerInvariant() : "lectura";
            _grupos = TiposRecurso
                .Select(t => new Grupo(t.Tipo, t.Titulo, t.Indice, modulo.Enlaces.Where(e => TipoDe(e) == t.Tipo).ToList()))
                .Where(g => g.Enlaces.Count > 0)
                .ToList();

            _secciones = [];
            if (!string.IsNullOrWhiteSpace(_teoria)) _secciones.Add(("teoria", "Teoría"));
            if (modulo.Videos.Count > 0) _secciones.Add(("videos", "Videos"));
            _secciones.AddRange(_grupos.Select(g => (g.Id, g.Indice)));
            _secciones.Add(("reto", "🎯 Speaking Challenge"));

            _modulo = modulo;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task IrAAsync(string id) => await JS.InvokeVoidAsync("fonetica.irA", id);

    private async Task AbrirFormularioAsync() =>
        await Analitica.EventoAsync("abrir_formulario", new { modulo = _modulo?.Numero, reto = _modulo?.Reto.Titulo });
}
